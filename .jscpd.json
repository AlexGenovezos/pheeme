{
  "path": ["src", "src-tauri/src", "workers", "scripts"],
  "ignore": [
    "**/*.test.*",
    "**/fixtures/**",
    "**/tests.rs",
    "**/tests/**",
    "src/preview/**",
    "**/migrations/**"
  ],
  "minTokens": 70,
  "similarity": 0.9,
  "minNodes": 80,
  "baseline": ".jscpd-baseline.json",
  "format": ["javascript", "typescript", "tsx", "jsx", "rust", "css"]
}
