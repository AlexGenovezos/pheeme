{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pheeme-website",
  "account_id": "16ff14fb0430f18bc095f18a64b11c7e",
  "compatibility_date": "2026-10-01",
  // Marketing pages and the real app preview, generated by npm run build:site.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "pheeme.app", "custom_domain": true },
    { "pattern": "www.pheeme.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": true
}
