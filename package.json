{
  "name": "pheeme",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && node scripts/check-tokens.mjs",
    "test": "vitest",
    "test:ci": "vitest run",
    "preview": "vite preview",
    "tauri": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri",
    "test:coverage": "vitest run --coverage",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "icons": "tauri icon src-tauri/app-icon.svg && node -e \"for (const d of ['android','ios','64x64.png']) require('fs').rmSync('src-tauri/icons/'+d, {recursive: true, force: true})\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "date-fns": "^3",
    "dompurify": "^3",
    "lucide-react": "^0.577.0",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "2.1.9",
    "cross-env": "^7",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.8.3",
    "vite": "^6",
    "vitest": "^2"
  }
}
