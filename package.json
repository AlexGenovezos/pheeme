{
  "name": "pheeme",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs && vite build",
    "build:site": "tsrs && node site/scripts/build.mjs",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p tsconfig.e2e.json",
    "typecheck:typescript": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --deny-warnings && node scripts/check-tokens.mjs",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:site": "playwright test --config site/playwright.config.ts",
    "preview": "vite preview",
    "tauri": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri",
    "test:coverage": "vitest run --coverage",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "ui:score": "node scripts/ui-score/run.mjs",
    "icons": "tauri icon src-tauri/app-icon.svg && node -e \"for (const d of ['android','ios','64x64.png']) require('fs').rmSync('src-tauri/icons/'+d, {recursive: true, force: true})\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:memory": "playwright test e2e/memory.spec.ts"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-shell": "2.6.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "chrono-node": "2.10.3",
    "culori": "4.0.2",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.70.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "cross-env": "10.1.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
