  "db_name": "SQLite",
  "query": "\n        SELECT id, account_id, subject, snippet, history_id,\n               label_ids, last_message_date, message_count, unread_count, has_attachment\n        FROM threads\n        WHERE account_id = ?\n          AND EXISTS (\n            SELECT 1 FROM json_each(label_ids) WHERE value = ?\n          )\n        ORDER BY last_message_date DESC\n        LIMIT ? OFFSET ?\n        ",
