{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pheeme mod API 1 manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "apiVersion": {
      "const": 1
    },
    "entry": {
      "type": "string",
      "pattern": "\\.js$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "shortcut": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": ["id", "title"]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#]+/?$"
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "authorizationUrl": {
                "type": "string",
                "format": "uri"
              },
              "tokenUrl": {
                "type": "string",
                "format": "uri"
              },
              "scopes": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "apiOrigins": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/?#]+/?$"
                }
              }
            },
            "required": ["id", "name", "authorizationUrl", "tokenUrl", "scopes", "apiOrigins"]
          }
        }
      },
      "required": []
    }
  },
  "required": ["id", "name", "version", "apiVersion", "entry"]
}
